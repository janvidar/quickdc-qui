// The executable's icon and version, as Explorer and the installer read them.
// IDI_ICON1 is the name Qt looks for to give its windows the same icon.
#include <winver.h>

IDI_ICON1 ICON "@QUICKDC_QUI_ICO@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "QuickDC"
            VALUE "FileDescription",  "QuickDC"
            VALUE "FileVersion",      "@QUICKDC_QUI_VERSION_STRING@"
            VALUE "InternalName",     "QuickDC"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Jan Vidar Krey"
            VALUE "OriginalFilename", "QuickDC.exe"
            VALUE "ProductName",      "QuickDC"
            VALUE "ProductVersion",   "@QUICKDC_QUI_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
